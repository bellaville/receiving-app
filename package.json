{
  "name": "receiving-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:rules": "node scripts/gen-rules.ts",
    "check:rules": "node scripts/gen-rules.ts --check",
    "build": "npm run check:rules && npm run check:forms && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:forms": "node scripts/form-lock.ts --check",
    "lock:forms": "node scripts/form-lock.ts",
    "gen:blank-pdf": "node scripts/gen-blank-pdf.ts"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "pdfmake": "^0.3.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  }
}
