// GENERATED by scripts/gen-rules.ts from src/forms/receipt.ts. Do not edit by hand:
// change the field list, then run `npm run gen:rules`.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Verified company Google account
    function isStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@growtown[.]ca$');
    }

    // One row of "items"
    function valid_items_row(r) {
      return r is map
        && r.keys().hasOnly(['item_number', 'vessel_number', 'supplier_tare_weight', 'supplier_net_weight', 'growtown_net_weight', 'packaging_check', 'comments'])
        && r.keys().hasAll(['item_number', 'vessel_number', 'supplier_tare_weight', 'supplier_net_weight', 'growtown_net_weight', 'packaging_check'])
        && (r.item_number is string && r.item_number.size() > 0 && r.item_number.size() <= 200)
        && (r.vessel_number is string && r.vessel_number.size() > 0 && r.vessel_number.size() <= 200)
        && ((r.supplier_tare_weight is int || r.supplier_tare_weight is float) && r.supplier_tare_weight >= 0 && (r.supplier_tare_weight is int || math.abs(r.supplier_tare_weight * 100 - math.round(r.supplier_tare_weight * 100)) < 0.000001))
        && ((r.supplier_net_weight is int || r.supplier_net_weight is float) && r.supplier_net_weight >= 0 && (r.supplier_net_weight is int || math.abs(r.supplier_net_weight * 100 - math.round(r.supplier_net_weight * 100)) < 0.000001))
        && ((r.growtown_net_weight is int || r.growtown_net_weight is float) && r.growtown_net_weight >= 0 && (r.growtown_net_weight is int || math.abs(r.growtown_net_weight * 100 - math.round(r.growtown_net_weight * 100)) < 0.000001))
        && (r.packaging_check in ['Pass', 'Fail'])
        && (!('comments' in r) || (r.comments is string && r.comments.size() > 0 && r.comments.size() <= 500));
    }

    // Receipt form values, version 3
    function validReceiptValues(v) {
      return v.keys().hasOnly(['name', 'date_received', 'returned_product', 'supplier_lot', 'growtown_lot', 'items'])
        && v.keys().hasAll(['name', 'date_received', 'returned_product', 'supplier_lot', 'growtown_lot', 'items'])
        && (v.name is string && v.name.size() > 0 && v.name.size() <= 200)
        && (v.date_received is string && v.date_received.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (v.returned_product in ['Yes', 'No'])
        && (v.supplier_lot is string && v.supplier_lot.size() > 0 && v.supplier_lot.size() <= 200)
        && (v.growtown_lot is string && v.growtown_lot.size() > 0 && v.growtown_lot.size() <= 200)
        && (v.items is list
          && v.items.size() >= 1
          && v.items.size() <= 10
          && (v.items.size() <= 0 || valid_items_row(v.items[0]))
          && (v.items.size() <= 1 || valid_items_row(v.items[1]))
          && (v.items.size() <= 2 || valid_items_row(v.items[2]))
          && (v.items.size() <= 3 || valid_items_row(v.items[3]))
          && (v.items.size() <= 4 || valid_items_row(v.items[4]))
          && (v.items.size() <= 5 || valid_items_row(v.items[5]))
          && (v.items.size() <= 6 || valid_items_row(v.items[6]))
          && (v.items.size() <= 7 || valid_items_row(v.items[7]))
          && (v.items.size() <= 8 || valid_items_row(v.items[8]))
          && (v.items.size() <= 9 || valid_items_row(v.items[9])));
    }

    match /cannabis_receipts/{id} {
      allow read: if isStaff();

      // New receipts only, on the current form version. Update and delete are denied (no rule grants them).
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['form_version', 'values', 'created_by', 'created_at'])
        && request.resource.data.keys().hasAll(['form_version', 'values', 'created_by', 'created_at'])
        && request.resource.data.form_version == 3
        && request.resource.data.values is map
        && validReceiptValues(request.resource.data.values)
        && request.resource.data.created_by == request.auth.token.email
        && request.resource.data.created_at == request.time;
    }
  }
}
