rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Verified company Google account
    function isStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@growtown[.]ca$');
    }

    // Required, trimmed-by-client text: non-empty and capped (cap matches MAX_TEXT in NewReceipt.tsx)
    function validText(v) {
      return v is string && v.size() > 0 && v.size() <= 200;
    }

    match /cannabis_receipts/{id} {
      allow read: if isStaff();

      // New receipts only. Update and delete are denied (no rule grants them).
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(
             ['name', 'date_received', 'supplier_lot', 'growtown_lot', 'created_by', 'created_at'])
        && request.resource.data.keys().hasAll(
             ['name', 'date_received', 'supplier_lot', 'growtown_lot', 'created_by', 'created_at'])
        && validText(request.resource.data.name)
        && validText(request.resource.data.supplier_lot)
        && validText(request.resource.data.growtown_lot)
        && request.resource.data.date_received is string
        && request.resource.data.date_received.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.created_by == request.auth.token.email
        && request.resource.data.created_at == request.time;
    }
  }
}
